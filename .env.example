# Supabase (opcjonalne lokalnie — zostaw puste dla trybu MVP bez logowania)
# Project Settings → API w panelu Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Publiczny adres aplikacji (linki marketingowe „Testuj za darmo” → {URL}/signup). Na Vercel: https://wizytaok.vercel.app
# NEXT_PUBLIC_SITE_URL=https://wizytaok.vercel.app

# Testowe integracje (panel admina) — na produkcji zwykle false; patrz docs/TEST_INTEGRATIONS_FLAGS.md
ENABLE_TEST_NOTIFICATIONS=false
ENABLE_TEST_BILLING=false

# Stripe (tylko test: sk_test_, pk_test_, price_…, whsec_…)
# NEXT_PUBLIC_SITE_URL=https://twoja-domena.vercel.app
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
