# Supabase (opcjonalne lokalnie — zostaw puste dla trybu MVP bez logowania)
# Project Settings → API w panelu Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Tylko serwer (Vercel) — tworzenie profilu przy /start-trial, webhook Stripe, checkout. Nie commituj do repo.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar (osobne OAuth od logowania Supabase)
# npm run setup:google-calendar — sprawdza konfigurację i pokazuje linki
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=  # min. 32 znaki, losowy ciąg
# Redirect URI: http://localhost:3000/api/integrations/google-calendar/callback
# Produkcja: https://wizytaok.vercel.app/api/integrations/google-calendar/callback

# Publiczny adres aplikacji (linki marketingowe „Testuj za darmo” → {URL}/signup). Na Vercel: https://wizytaok.vercel.app
# NEXT_PUBLIC_SITE_URL=https://wizytaok.vercel.app

# Testowe integracje (panel admina) — na produkcji zwykle false; patrz docs/TEST_INTEGRATIONS_FLAGS.md
ENABLE_TEST_NOTIFICATIONS=false
# Karta testowej subskrypcji w Ustawieniach. Okres próbny (/start-trial) działa też bez tej flagi, jeśli ustawisz STRIPE_SECRET_KEY + STRIPE_PRICE_ID (+ NEXT_PUBLIC_SITE_URL).
ENABLE_TEST_BILLING=false

# Stripe (sk_test_/pk_test_ lub sk_live_/pk_live_, price_…, whsec_…)
# NEXT_PUBLIC_SITE_URL=https://twoja-domena.vercel.app
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
